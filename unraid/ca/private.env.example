# Example for unraid/ca/private.env (git-ignored): a template variant for your own Unraid server
# that pulls from a private registry, e.g. a Gitea on your LAN. Copy it, fill in your values:
#   cp unraid/ca/private.env.example unraid/ca/private.env
#   make ca-private   ->  unraid/ca/out/dupearr-private.xml   (git-ignored)
# It is rendered on top of publish.env; only the location keys are overridden here.
# Never commit or publish the result: the public repository must hold exactly one template.
#
# PUBLIC_* here means "where this template points", not "public".
PUBLIC_HOST=gitea.home.arpa:3000
PUBLIC_OWNER=your-gitea-user
PUBLIC_REPO=dupearr
PUBLIC_BRANCH=main
PUBLIC_REPO_URL=http://gitea.home.arpa:3000/your-gitea-user/dupearr
PUBLIC_RAW_BASE=http://gitea.home.arpa:3000/your-gitea-user/dupearr/raw/branch/main
README_URL=http://gitea.home.arpa:3000/your-gitea-user/dupearr/src/branch/main/unraid/README.md
SUPPORT_URL=http://gitea.home.arpa:3000/your-gitea-user/dupearr/issues
IMAGE=gitea.home.arpa:3000/your-gitea-user/dupearr:latest
REGISTRY_URL=http://gitea.home.arpa:3000/your-gitea-user/-/packages/container/dupearr
# Appended to <Requires>. Keep the leading space. Leave it out for a registry with TLS.
REQUIRES_EXTRA=" This image comes from a plain-HTTP registry (no encryption, no server authentication): only install it when the registry is on a network you trust, add --insecure-registry=gitea.home.arpa:3000 to DOCKER_OPTS in /boot/config/docker.cfg and restart Docker first (see unraid/README.md)."
