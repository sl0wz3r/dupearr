{{# Lines starting with the comment marker are dropped; placeholders: see unraid/ca/render.sh.    }}
{{# CA/dockerMan format rules (checked by unraid/ca/validate-template.sh):                         }}
{{#   one Config element per line; write &amp; for &; no angle brackets in text;                    }}
