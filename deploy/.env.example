# Copy to .env next to docker-compose.yml and adjust. Variable names follow the TRaSH Guides
# compose example, so an existing TRaSH .env can be reused as-is.

# Image (public, linux/amd64 and linux/arm64).
# Safer: pin a version and its digest (release notes), which Docker verifies on every pull:
#   DUPEARR_IMAGE=ghcr.io/sl0wz3r/dupearr:0.2.0@sha256:<digest>
DUPEARR_IMAGE=ghcr.io/sl0wz3r/dupearr:latest
# Host port for the web UI / API (container port is always 3873).
DUPEARR_PORT=3873

# User/group Dupearr runs as. Use the ids that own your media (run `id` as that user).
# Unraid: 99/100. Synology: your docker user's uid, gid 100. TrueNAS apps: 568/568.
PUID=1000
PGID=1000
# 002 keeps created files group-writable (shared "media" group), 022 = owner-only write.
UMASK=002
# IANA time zone name, e.g. Europe/Amsterdam or America/New_York.
TZ=Etc/UTC

# Parent folder of per-app config folders (Dupearr uses $DOCKERCONFDIR/dupearr -> /config).
DOCKERCONFDIR=/docker/appdata
# Root of the shared media tree (torrents/, usenet/, media/) -> /data, same as Plex/*arr.
DOCKERSTORAGEDIR=/data

# Reverse proxy (SWAG, Nginx Proxy Manager, Traefik, Caddy) in front of Dupearr: the proxy's
# address as Dupearr sees it (its container IP on a user-defined Docker network, not the gateway),
# comma-separated IPs or CIDR ranges. Leave empty without a proxy.
DUPEARR_TRUSTED_PROXIES=
# Optional: the host names Dupearr is reached by through the proxy (e.g. dupearr.example.com).
DUPEARR_ALLOWED_HOSTS=
