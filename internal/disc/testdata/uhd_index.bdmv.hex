# Hand-verified UHD index.bdmv with the HEVC extension (id1 3, id2 1).

# 0x00 header
49 4E 44 58             # "INDX"
30 33 30 30             # "0300" (Ultra HD Blu-ray)
00 00 00 4E             # indexes_start        = 0x4E (78)
00 00 00 78             # extension_data_start = 0x78 (120)
00*24                   # reserved, up to 0x28

# 0x28 AppInfoBDMV
00 00 00 22             # length 34
21                      # content_exist_flag, initial_dynamic_range_type 1 (HDR10)
81                      # video_format 8 (2160p) | frame_rate 1
00*32                   # user data, up to 0x4E

# 0x4E Indexes
00 00 00 26             # length 38 = 12 + 12 + 2 + 12
40 00 00 00 00 00 00 00 00 00 00 00   # First Playback (HDMV)
40 00 00 00 00 00 00 01 00 00 00 00   # Top Menu
00 01                   # number_of_Titles = 1
40 00 00 00 00 00 00 02 00 00 00 00   # Title 1

# 0x78 ExtensionData
00 00 00 20             # length 32 = 0x9C - 0x7C
00 00 00 18             # data block start (relative) = 24
00 00 00                # padding
01                      # 1 entry
00 03 00 01 00 00 00 18 00 00 00 0C   # id1 3, id2 1, start +24 (0x90), length 12
# 0x90 HEVC extension
00 00 00 08             # length 8
11                      # disc_type 1 | 3 bits | exist_4k_flag 1
00                      # 8 bits
05                      # 3 bits | hdrplus_flag 0 | 1 bit | dv_flag 1 | hdr_flags 01
00                      # 8 bits
00 00 00 00             # 32 bits
# 0x9C end (156 bytes)
